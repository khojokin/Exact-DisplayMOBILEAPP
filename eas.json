{
  "cli": {
    "version": ">= 19.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "ft": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SKIP_CLERK": "1",
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": ""
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildType": "app-store"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
